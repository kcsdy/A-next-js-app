# --- Contact form delivery -------------------------------------------------
# Sign up at resend.com, verify the sending domain, then paste the key here.
RESEND_API_KEY=""

# Must be an address on a domain verified in Resend.
# Until the real domain is verified, onboarding@resend.dev works for testing.
CONTACT_FROM="MCH Kancelaria <formularz@example.pl>"

# Where enquiries land.
CONTACT_TO="kontakt@example.pl"

# --- Spam protection (optional but recommended before launch) --------------
# Free at dash.cloudflare.com -> Turnstile. Leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ------------------------------------------------------------------
# Used for canonical URLs and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Calendeo booking webhook -> Google Meet + calendar invite -------------
# One-time setup: visit /api/auth/google/start signed into the Google
# account that should own these events, approve access, then paste the
# refresh token the callback shows you below. See src/app/api/auth/google/
# start/route.ts for the Google Cloud Console steps that come first.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# In the Calendeo dashboard: Integrations -> Webhook tile -> "Generate secret"
# (shown once — copy it here) -> paste this site's URL into the Webhook's
# "URL" field: https://yourdomain.com/api/webhooks/calendeo
# Leave blank while testing locally; the route skips signature verification
# until this is set.
CALENDEO_WEBHOOK_SECRET=""
