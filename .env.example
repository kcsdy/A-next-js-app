# --- Contact form delivery -------------------------------------------------
# Sent through the firm's own Google Workspace mailbox over SMTP.
# SMTP_PASS is an app password for office@mchimmigration.pl, not the account
# password: turn on 2-Step Verification for the mailbox, then create one at
# myaccount.google.com/apppasswords.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="office@mchimmigration.pl"
SMTP_PASS=""

# Sender shown on the notification; must be the mailbox above (or an alias of it).
CONTACT_FROM="MCH Kancelaria Imigracyjna <office@mchimmigration.pl>"

# Where enquiries land.
CONTACT_TO="office@mchimmigration.pl"

# --- Spam protection (optional but recommended before launch) --------------
# Free at dash.cloudflare.com -> Turnstile. Leave both blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ------------------------------------------------------------------
# Used for canonical URLs and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
